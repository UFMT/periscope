# Production environment template for docker-compose.prod.yml
PERISCOPE_DOMAIN=localhost
PERISCOPE_CORS_ORIGINS=https://localhost
PERISCOPE_COOKIE_SECURE=true

# MongoDB 7 credentials
MONGO_INITDB_ROOT_USERNAME=periscope
MONGO_INITDB_ROOT_PASSWORD=change-this-strong-mongo-password
MONGODB_DATABASE=Periscope

# Mandatory JWT secret in production (at least 32 characters)
PERISCOPE_JWT_SECRET=replace-with-a-random-32-byte-secret-value
PERISCOPE_JWT_EXPIRATION_HOURS=8

# Initial admin seed overrides (first startup only)
PERISCOPE_ADMIN_USERNAME=admin
PERISCOPE_ADMIN_PASSWORD=change-this-initial-admin-password
PERISCOPE_ADMIN_EMAIL=admin@ufmt.br
PERISCOPE_FORCE_ADMIN_PASSWORD_CHANGE=true
